{
  "name": "review-bench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Demo bench for automated code review: team rules checked by a local LLM (Ollama) and SonarQube Cloud.",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test",
    "test:ci": "ng test --watch=false --coverage --coverage-reporters=lcov --coverage-reporters=text-summary",
    "review": "node tools/llm-review/src/cli.ts",
    "review:prs": "node tools/llm-review/src/pr-cli.ts",
    "typecheck": "tsc -p tools/tsconfig.json"
  },
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.1",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1"
  }
}
